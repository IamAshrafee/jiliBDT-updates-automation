[Unit]
Description=JiliBDT Updates backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jilibdt
Group=jilibdt
WorkingDirectory=/opt/jilibdt-updates/app
EnvironmentFile=/opt/jilibdt-updates/secrets/app.env
ExecStart=/usr/local/bin/pnpm --filter @jilibdt/server start
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jilibdt-updates/data /opt/jilibdt-updates/artifacts /opt/jilibdt-updates/backups /opt/jilibdt-updates/logs

[Install]
WantedBy=multi-user.target
