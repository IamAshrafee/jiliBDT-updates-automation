# Local SQLite file. The data directory is ignored by Git.
DATABASE_URL=./data/jilibdt.db

# Google OAuth files. Never commit the real files.
GOOGLE_OAUTH_CREDENTIALS_PATH=./data/credentials.json
GOOGLE_OAUTH_TOKEN_PATH=./data/token.json

# Google Sheet source
GOOGLE_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_WORKSHEET_TITLE=replace-with-worksheet-title
UPDATE_1_RANGE=A1:H46
UPDATE_2_RANGE=J1:Q46
UPDATE_3_RANGE=S1:Z46

TIMEZONE=Asia/Dhaka
ARTIFACTS_DIR=./artifacts

# Server and one-administrator login
HOST=127.0.0.1
PORT=4100
# Transitional local API token; session login is preferred in Phase 2.
ADMIN_API_TOKEN=replace-with-a-long-random-local-token
ADMIN_USERNAME=admin
# Generate with: pnpm admin:password -- "your password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_HOURS=12
ADMIN_UI_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100

# One team, one Telegram user account, one administrator bot
TEAM_NAME=JiliBDT
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_SESSION_PATH=./data/telegram.session.enc
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Persistent scheduler and workflow defaults
SCHEDULER_TICK_SECONDS=15
DEFAULT_RECHECK_DELAY_SECONDS=240
DEFAULT_ESCALATION_DELAY_SECONDS=240
MAX_REMINDER_STAGES=2
ARTIFACT_RETENTION_DAYS=90

# Initial configurable completion policy
COMPLETION_EXEMPT_REMARKS=DAY OFF
COMPLETION_ACTIVE_REMARKS=ACTIVE
COMPLETION_ALLOWED_MEMBER_STATUSES=PERMANENT
