# Local SQLite file. The data directory is ignored by Git.
DATABASE_URL=./data/jilibdt.db

# Google OAuth files. Never commit the real files.
GOOGLE_OAUTH_CREDENTIALS_PATH=./data/credentials.json
GOOGLE_OAUTH_TOKEN_PATH=./data/token.json

# Google Sheet source
GOOGLE_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_WORKSHEET_TITLE=replace-with-worksheet-title
UPDATE_1_RANGE=A1:H46
UPDATE_2_RANGE=J1:Q46
UPDATE_3_RANGE=S1:Z46

TIMEZONE=Asia/Dhaka
ARTIFACTS_DIR=./artifacts

# Phase 1 server/admin settings
HOST=127.0.0.1
PORT=4100
ADMIN_API_TOKEN=replace-with-a-long-random-local-token
ADMIN_UI_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100

# Initial configurable completion policy
COMPLETION_EXEMPT_REMARKS=DAY OFF
COMPLETION_ACTIVE_REMARKS=ACTIVE
COMPLETION_ALLOWED_MEMBER_STATUSES=PERMANENT
