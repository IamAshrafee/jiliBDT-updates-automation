{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@jilibdt/config": ["packages/config/src/index.ts"],
      "@jilibdt/db": ["packages/db/src/index.ts"],
      "@jilibdt/domain": ["packages/domain/src/index.ts"],
      "@jilibdt/google-sheet": ["packages/google-sheet/src/index.ts"],
      "@jilibdt/renderer": ["packages/renderer/src/index.ts"]
    }
  }
}
